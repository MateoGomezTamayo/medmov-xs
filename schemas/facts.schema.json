{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facts.schema.json",
  "title": "Case facts (cases/*.json)",
  "type": "object",
  "required": ["case_id", "description", "facts"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "description": { "type": "string" },
    "location": { "type": "string" },
    "facts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*([.][a-z0-9_]+)+$" },
      "additionalProperties": { "type": ["boolean", "number", "string", "array"] }
    }
  }
}
